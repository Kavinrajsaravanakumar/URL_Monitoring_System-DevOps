# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB Configuration
DYNAMODB_TABLE_URLS=url-monitor-backend-dev-urls
DYNAMODB_TABLE_RESULTS=url-monitor-backend-dev-results

# SNS Alerting Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:url-monitor-backend-dev-alerts-topic

# Axios timeout for URL checks (in milliseconds)
CHECK_TIMEOUT=10000
